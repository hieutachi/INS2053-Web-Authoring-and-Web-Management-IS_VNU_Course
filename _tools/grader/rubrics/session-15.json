        { "type": "cssDeclEquals", "file": "css/style.css", "selector": "img", "prop": "height", "value": "auto", "weight": 2 },
        {
          "type": "noInlineStyle",
          "files": ["index.html", "about.html", "activities.html", "media.html", "contact.html"],
          "maxCount": 0
