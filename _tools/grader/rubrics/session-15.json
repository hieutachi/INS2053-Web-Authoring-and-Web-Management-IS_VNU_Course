        {
          "type": "hasElement",
          "files": ["index.html", "about.html", "activities.html", "media.html", "contact.html"],
          "tag": "meta",
          "attr": { "name": "viewport", "content": "~initial-scale=1" },
          "weight": 2
        },
        {
          "type": "elementInside",
          "files": ["index.html", "about.html", "activities.html", "media.html", "contact.html"],
          "tag": "meta",
          "inside": "head",
          "all": true
        }
      ]
    },
    {
      "id": "media-query",
      "criteria": "Media query",
      "points": 3,
      "tier": "auto",
