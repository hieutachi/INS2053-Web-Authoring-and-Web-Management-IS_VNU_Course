        { "type": "cssDeclEquals", "file": "css/style.css", "selector": "form input", "prop": "width", "value": "100%", "weight": 2 },
        { "type": "cssMinDecls", "file": "css/style.css", "selector": "nav ul", "minCount": 3 }
      ]
    },
    {
