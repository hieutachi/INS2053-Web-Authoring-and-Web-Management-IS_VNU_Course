# Operating-system and editor files
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
.claude/
.commandcode/

# Local archives and rollback snapshots
_archive/
_tools/backups/

# Vendored third-party drops — not course content, nothing in the build reads them
_tools/grader/ClaudeKit-Clean/

# Generated audit output (recreate with the scripts in _tools/)
_tools/*.txt

# One-off audit probes. The re-runnable QA scripts have no tmp- prefix.
_tools/tmp-*.js
_tools/tmp-*.mjs

# Common generated dependencies and build output
node_modules/
.vercel/
dist/
build/
coverage/
*.log
*.tmp
*.temp
